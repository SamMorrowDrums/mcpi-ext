{
  "name": "@sammorrowdrums/mcpi-ext",
  "version": "1.0.2",
  "description": "MCP extension for mcpi — skills, tool-cli, and code mode behind one authorization boundary",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpi",
    "extension",
    "skills",
    "agent",
    "tool-cli",
    "code-mode"
  ],
  "homepage": "https://github.com/SamMorrowDrums/mcpi-ext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamMorrowDrums/mcpi-ext.git"
  },
  "bugs": {
    "url": "https://github.com/SamMorrowDrums/mcpi-ext/issues"
  },
  "author": "Sam Morrow",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/fixtures.js",
    "!dist/**/fixtures.d.ts",
    "!dist/**/fixtures/**",
    "!dist/test-servers/**",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "build:release": "node --run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "node --run build:release && node --run release:check",
    "release:check": "node scripts/release-check.mjs",
    "start": "node dist/index.js",
    "test": "vitest --run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@sammorrowdrums/tool-cli": "^1.0.2",
    "typebox": "^1.3.25",
    "yaml": "2.9.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "isolated-vm": "~6.2.0"
  },
  "peerDependencies": {
    "@sammorrowdrums/mcpi": ">=0.85.2 <1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sammorrowdrums/mcpi": "^0.85.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "qs": "^6.16.0",
    "@anthropic-ai/sdk": ">=0.91.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
